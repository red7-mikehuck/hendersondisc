# --- Lead delivery (required in production) ---
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where new leads are emailed. Comma-separate for multiple recipients.
LEAD_RECIPIENT=
# Sender. The domain must be verified in Resend (default: Henderson Disc <leads@hendersondisc.com>).
LEAD_FROM=

# --- Optional ---
# POST every lead as JSON to a CRM / FormDr endpoint.
CRM_WEBHOOK_URL=
# GA4 measurement id (G-XXXXXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=
# Canonical site URL (defaults to https://hendersondisc.com).
NEXT_PUBLIC_SITE_URL=
